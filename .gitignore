# ==========================================
# SYMAH - Git Ignore
# ==========================================

# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------
# Runtime data
# ------------------------------------------
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# Node.js
# ------------------------------------------
node_modules/
jspm_packages/

# npm
.npm

# pnpm
.pnpm-store/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity

# ------------------------------------------
# Build / compiled files
# ------------------------------------------
dist/
build/
build/Release/

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo

# ------------------------------------------
# Test / coverage
# ------------------------------------------
coverage/
*.lcov
.nyc_output/
lib-cov/

# ------------------------------------------
# Cache / temporary files
# ------------------------------------------
.cache/
.parcel-cache/
.grunt/
.temp/
.fusebox/

# ------------------------------------------
# Framework generated files
# ------------------------------------------
.next/
.nuxt/
.output/
.svelte-kit/
.docusaurus/
.vuepress/dist/
**/.vitepress/dist
**/.vitepress/cache

# ------------------------------------------
# Environment variables
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# IDE / Editor
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo

# VSCode extension test files
.vscode-test/

# ------------------------------------------
# Local databases / development data
# ------------------------------------------
data/
backups/
*.dump
*.archive

# ------------------------------------------
# SyMAH - Historical documentation
# ------------------------------------------
# Documentation created before the current
# architecture/version of the project.
/Diagrama de Clases.png
/Requerimientos/
/structure.md

# ------------------------------------------
# SyMAH - Local production files
# ------------------------------------------
# Keep local production/development files
# outside the public repository.
/Produccion/
/Desarrollo/

# ------------------------------------------
# Miscellaneous
# ------------------------------------------
*.tgz
.lock-wscript
.node_repl_history
.grunt
bower_components/
bower_components
web_modules/
