{
  "name": "symah",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter frontend --filter symah-backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter symah-backend dev",
    "test:backend": "pnpm --filter symah-backend test",
    "stop": "node scripts/stop-dev.js",
    "dev:stop": "pnpm stop"
  }
}
